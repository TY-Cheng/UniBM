# Unset or blank: out/reports/. Relative paths use the code repository root.
# UNIBM_REPORT_DIR="/path/to/your/report-project"

# Optional external Python environment; unset uses uv's default .venv/.
# just loads this file before starting uv. For ad hoc commands, use just --command uv ...
# UV_PROJECT_ENVIRONMENT="/Users/yourname/.venvs/unibm"
